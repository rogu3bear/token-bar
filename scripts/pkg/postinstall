#!/bin/bash
# Runs as root after the payload is written.
#
# Registers the freshly installed bundle with Launch Services so the system
# resolves this bundle identifier to /Applications and not to a stale copy left
# in a downloads or archive folder. Nothing outside /Applications is touched:
# removing a user's files is not the installer's business, and the app reports
# any other copy it finds instead.
set -u
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
[ -x "$LSREGISTER" ] && "$LSREGISTER" -f "/Applications/Token Bar.app" >/dev/null 2>&1

# Relaunch for the person at the console. preinstall quit their previous copy,
# and the installer runs as root, so the launch is handed to their GUI session.
# No console user, a root console, or a failed open stays silent: the install
# itself succeeded and the app can be opened from Applications.
console_user=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null) || console_user=""
if [ -n "$console_user" ] && [ "$console_user" != "root" ]; then
    uid=$(/usr/bin/id -u "$console_user" 2>/dev/null) || uid=""
    if [ -n "$uid" ]; then
        /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -a "/Applications/Token Bar.app" >/dev/null 2>&1 || true
    fi
fi
exit 0
